    {
      "name": "alagamento",
      "item": [
        {
          "name": "nivel_corrego",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8082/alagamento/leituras",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensor_id\": \"NIVEL-001\",\n  \"ponto_id\": \"PONTO-001\",\n  \"tipo\": \"nivel_corrego\",\n  \"valor\": 210,\n  \"unidade\": \"cm\",\n  \"timestamp\": \"{{instante_sensor}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"instante_sensor\", new Date().toISOString());"
                ]
              }
            }
          ]
        },
