{
  "info": {
    "name": "APS - Sensores, historico, SSE e alertas",
    "description": "Execucao Java local. POST aceita dados com HTTP 202 e persistencia pendente. Alagamento agrupa sensores em ate 3 segundos. SSE transmite sem esperar SQLite. Alertas recentes duram 60 segundos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "manancial",
      "item": [
        {
          "name": "Enviar leitura",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "http://localhost:8081/manancial/leituras",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"area\": \"AREA-001\",\n  \"timestamp\": \"2026-09-25T12:00:00Z\",\n  \"percentual_ocupado\": 15,\n  \"nivel_agua_m\": 5,\n  \"temperatura_agua_c\": 22\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Consultar historico",
