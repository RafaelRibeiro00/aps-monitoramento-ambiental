      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "manancial-estado",
        "namespace": "aps-lab"
      },
      "spec": {
        "serviceName": "manancial-estado",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "manancial-estado"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "manancial-estado",
              "camada": "estado"
            }
          },
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "aps-experimentos-control-plane"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "terminationGracePeriodSeconds": 40,
            "securityContext": {
              "fsGroup": 10001
            },
            "initContainers": [
              {
                "name": "permissoes",
                "image": "busybox:1.37",
                "command": [
                  "sh",
                  "-c",
                  "chown 10001:10001 /dados"
                ],
                "volumeMounts": [
                  {
                    "name": "dados",
                    "mountPath": "/dados"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "api",
                "image": "aps-manancial:3.0.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8081
                  }
                ],
                "env": [
                  {
                    "name": "APS_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "APS_PORT",
                    "value": "8081"
                  },
                  {
                    "name": "APS_VERSAO",
                    "value": "3.0.0"
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "JAVA_TOOL_OPTIONS",
                    "value": "-Xms16m -Xmx64m -Xss256k -XX:ActiveProcessorCount=2"
                  },
                  {
                    "name": "APS_DB",
                    "value": "/app/dados/aps.db"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8081
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8081
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8081
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "dados",
                    "mountPath": "/app/dados"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "dados",
                "persistentVolumeClaim": {
                  "claimName": "manancial-estado"
                }
              }
            ]
          }
        }
