      "metadata": {
        "name": "aps-ingress"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "ClusterRole",
        "name": "aps-ingress"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "ingress",
          "namespace": "aps-lab"
        }
      ]
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "IngressClass",
      "metadata": {
        "name": "aps"
      },
      "spec": {
        "controller": "traefik.io/ingress-controller"
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "ingress",
        "namespace": "aps-lab"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "ingress"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "ingress"
            }
          },
          "spec": {
            "serviceAccountName": "ingress",
            "nodeSelector": {
              "kubernetes.io/hostname": "aps-experimentos-control-plane"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "containers": [
              {
                "name": "ingress",
                "image": "traefik:v3.5.0",
                "args": [
                  "--providers.kubernetesingress=true",
                  "--providers.kubernetesingress.ingressclass=aps",
                  "--entrypoints.web.address=:8080",
                  "--entrypoints.web.transport.respondingtimeouts.writetimeout=0",
                  "--accesslog=true"
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "48Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "160Mi"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
