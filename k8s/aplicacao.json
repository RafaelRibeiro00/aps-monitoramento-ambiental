          "matchLabels": {
            "app": "inversao-termica-estado"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "inversao-termica-estado",
              "camada": "estado"
            }
          },
          "spec": {
            "nodeSelector": {
              "kubernetes.io/hostname": "aps-experimentos-control-plane"
            },
            "tolerations": [
              {
                "key": "node-role.kubernetes.io/control-plane",
                "operator": "Exists",
                "effect": "NoSchedule"
              }
            ],
            "terminationGracePeriodSeconds": 40,
            "securityContext": {
              "fsGroup": 10001
            },
            "initContainers": [
              {
                "name": "permissoes",
                "image": "busybox:1.37",
                "command": [
                  "sh",
                  "-c",
                  "chown 10001:10001 /dados"
                ],
                "volumeMounts": [
                  {
                    "name": "dados",
                    "mountPath": "/dados"
                  }
                ]
              }
            ],
            "containers": [
              {
                "name": "api",
                "image": "aps-inversao-termica:3.0.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8083
                  }
                ],
                "env": [
                  {
                    "name": "APS_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "APS_PORT",
                    "value": "8083"
                  },
                  {
                    "name": "APS_VERSAO",
                    "value": "3.0.0"
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "JAVA_TOOL_OPTIONS",
                    "value": "-Xms16m -Xmx64m -Xss256k -XX:ActiveProcessorCount=2"
                  },
                  {
                    "name": "APS_DB",
                    "value": "/app/dados/aps.db"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8083
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8083
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8083
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "96Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "dados",
                    "mountPath": "/app/dados"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "dados",
                "persistentVolumeClaim": {
                  "claimName": "inversao-termica-estado"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "inversao-termica-estado",
        "namespace": "aps-lab"
      },
      "spec": {
        "type": "ClusterIP",
        "selector": {
          "app": "inversao-termica-estado"
        },
        "ports": [
          {
            "port": 8083,
            "targetPort": 8083
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "inversao-termica",
        "namespace": "aps-lab"
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 5,
        "strategy": {
          "type": "RollingUpdate",
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          }
        },
        "selector": {
          "matchLabels": {
            "app": "inversao-termica"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "inversao-termica",
              "camada": "atendimento"
            }
          },
          "spec": {
            "terminationGracePeriodSeconds": 30,
            "containers": [
              {
                "name": "api",
                "image": "aps-inversao-termica:3.0.0",
                "imagePullPolicy": "IfNotPresent",
                "ports": [
                  {
                    "containerPort": 8083
                  }
                ],
                "env": [
                  {
                    "name": "APS_HOST",
                    "value": "0.0.0.0"
                  },
                  {
                    "name": "APS_PORT",
                    "value": "8083"
                  },
                  {
                    "name": "APS_VERSAO",
                    "value": "3.0.0"
                  },
                  {
                    "name": "POD_NAME",
                    "valueFrom": {
                      "fieldRef": {
                        "fieldPath": "metadata.name"
                      }
                    }
                  },
                  {
                    "name": "JAVA_TOOL_OPTIONS",
                    "value": "-Xms16m -Xmx64m -Xss256k -XX:ActiveProcessorCount=2"
                  },
                  {
                    "name": "APS_COORDENADOR",
                    "value": "http://inversao-termica-estado:8083"
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/health/ready",
                    "port": 8083
                  },
                  "periodSeconds": 3,
                  "timeoutSeconds": 2,
                  "failureThreshold": 3
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8083
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3,
                  "failureThreshold": 6
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/health/live",
                    "port": 8083
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "80Mi"
                  },
                  "limits": {
                    "cpu": "250m",
                    "memory": "160Mi"
                  }
                },
                "lifecycle": {
                  "preStop": {
                    "exec": {
                      "command": [
                        "sh",
                        "-c",
                        "sleep 5"
                      ]
                    }
                  }
                }
              }
            ],
            "topologySpreadConstraints": [
              {
                "maxSkew": 1,
                "topologyKey": "kubernetes.io/hostname",
                "whenUnsatisfiable": "ScheduleAnyway",
                "labelSelector": {
                  "matchLabels": {
                    "app": "inversao-termica"
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "inversao-termica",
        "namespace": "aps-lab"
      },
