{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "autoscaling/v2",
      "kind": "HorizontalPodAutoscaler",
      "metadata": {
        "name": "manancial",
        "namespace": "aps-lab"
      },
      "spec": {
        "scaleTargetRef": {
          "apiVersion": "apps/v1",
          "kind": "Deployment",
          "name": "manancial"
        },
        "minReplicas": 2,
        "maxReplicas": 10,
        "metrics": [
          {
            "type": "Resource",
            "resource": {
              "name": "cpu",
              "target": {
                "type": "Utilization",
                "averageUtilization": 60
              }
            }
          }
        ],
        "behavior": {
          "scaleDown": {
            "stabilizationWindowSeconds": 60
          }
        }
      }
    }
  ]
}