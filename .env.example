# Copie para .env. No Google Drive, use uma pasta fisica local para o SQLite.
APS_IMAGE_TAG=1.2.0
APS_DATA_DIR=./dados
APS_DB_FILE=aps.db
APS_BIND_HOST=127.0.0.1
MANANCIAL_PORT=8081
ALAGAMENTO_PORT=8082
INVERSAO_TERMICA_PORT=8083

# Limites didaticos de alerta, nao oficiais.
ALERTA_PERCENTUAL_BAIXO=20
ALERTA_NIVEL_CORREGO_CM=200
ALERTA_CHUVA_MM=50
ALERTA_TEMPERATURA_C=30
ALERTA_UMIDADE_MAX=30
ALERTA_VENTO_MAX_KM_H=5
# URL vazia: alertas salvos e visiveis na API; nenhum envio externo.
MANANCIAL_WEBHOOK_URL=
MANANCIAL_WEBHOOK_TOKEN=
ALAGAMENTO_WEBHOOK_URL=
ALAGAMENTO_WEBHOOK_TOKEN=
INVERSAO_TERMICA_WEBHOOK_URL=
INVERSAO_TERMICA_WEBHOOK_TOKEN=
