# Arquivos gerados pelo Maven e pelo Java
**/target/
*.class
*.log

# Configurações locais do IntelliJ; as configurações compartilhadas estão em .run/
.idea/
*.iml
out/

# Banco de dados local
*.db
*.db-journal
*.db-wal
*.db-shm

/SQLITE/
sqlite-*-sqlitejdbc.dll
__pycache__/
*.pyc
# Configuracao local e credenciais
.env
.env.*
!.env.example

# Arquivos locais do Windows e filas duraveis
desktop.ini
*.fila-*/

# Backup local da implantação Kind e evidências históricas (grande; não enviar ao GitHub)
/backup/

# Resultados brutos são preservados localmente e versionados no arquivo tar.gz.
# Resumos JSON, relatórios, gráficos e o arquivo compactado continuam rastreáveis.
resultados/**/carga-requisicoes.csv
resultados/**/carga-segundos.csv
resultados/**/eventos.jsonl
resultados/**/console.txt
resultados/**/ambiente.txt

# Artefatos temporários usados para renderizar e revisar documentos Word.
/tmp-documentacao-k3d/
/.tmp_docs/
/tmp/
~$*
*.inspect.ndjson
